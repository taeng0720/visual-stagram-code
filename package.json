{
  "name": "visual-stagram-code",
  "productName": "Visual Stagram Code",
  "version": "0.3.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node allow.js && node langs.js && node roman.js && node match.js && node camo.js && node templates.js && node workspace.js && node updater.js",
    "dist": "electron-builder --mac --win -c.directories.output=\"$TMPDIR/visual-stagram-code\" && mkdir -p dist && cp \"$TMPDIR\"/visual-stagram-code/*.dmg \"$TMPDIR\"/visual-stagram-code/*.exe dist/",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Instagram DMs in an editor that looks like VS Code",
  "author": "hongje",
  "build": {
    "appId": "com.visualstagramcode.app",
    "files": [
      "main.js",
      "allow.js",
      "index.html",
      "renderer.js",
      "scrape.js",
      "README.md",
      "vsstagram.svg",
      "bridge.js",
      "camo.js",
      "workspace.js",
      "langs.js",
      "templates.js",
      "icons/**",
      "roman.js",
      "match.js",
      "views.js",
      "preload.js",
      "updater.js"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "Visual-Stagram-Code-mac-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Visual-Stagram-Code-Setup.${ext}",
      "include": "build/installer.nsh"
    },
    "icon": "build/icon.png"
  },
  "updateRepo": "taeng0720/visual-stagram-code"
}
