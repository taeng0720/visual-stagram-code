{
  "name": "visual-stagram-code",
  "productName": "Visual Stagram Code",
  "version": "0.3.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node src/allow.js && node src/langs.js && node src/roman.js && node src/match.js && node src/camo.js && node src/templates.js && node src/workspace.js && node src/updater.js",
    "dist": "electron-builder --mac --win -c.directories.output=\"$TMPDIR/visual-stagram-code\" && mkdir -p dist && cp \"$TMPDIR\"/visual-stagram-code/*.dmg \"$TMPDIR\"/visual-stagram-code/*.exe dist/",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Instagram DMs in an editor that looks like VS Code",
  "author": "hongje",
  "build": {
    "appId": "com.visualstagramcode.app",
    "files": [
      "src/**",
      "README.md"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "dmg": {
      "artifactName": "Visual-Stagram-Code-mac-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Visual-Stagram-Code-Setup.${ext}",
      "include": "build/installer.nsh"
    },
    "icon": "build/icon.png"
  },
  "updateRepo": "taeng0720/visual-stagram-code"
}
